rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /favorites/{characterId} {
      allow read: if true;
      allow create, update: if isValidFavorite(characterId);
      allow delete: if isCharacterId(characterId);

      function isCharacterId(characterId) {
        return characterId.matches('^[0-9]{1,6}$');
      }

      function isValidFavorite(characterId) {
        return isCharacterId(characterId)
          && request.resource.data.keys().hasOnly(['characterId', 'createdAt'])
          && request.resource.data.characterId == characterId
          && request.resource.data.createdAt is number
          && request.resource.data.createdAt > 0;
      }
    }

    match /characters/{characterId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
